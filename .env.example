# Copy to .env for local dev. NEVER commit the real .env.
PORT=3000
NODE_ENV=development

# Postgres connection string. Production and staging use Neon (set per-service
# in the Render dashboard); locally, point this at your own Neon branch or a
# local Postgres. The app creates its tables on first connect.
# Neon URLs carry ?sslmode=require — keep it, that is what turns TLS on.
DATABASE_URL=postgresql://user:password@host.neon.tech/neondb?sslmode=require

# Optional simple shared-secret gate (leave blank to disable)
GHRUB_PASSPHRASE=

# M5 optional LLM insight layer — off by default
ENABLE_LLM=false
# ANTHROPIC_API_KEY=   # only needed if ENABLE_LLM=true
