<%- include('../partials/head', { title }) %>
  <header class="topbar">
    <h1>Scan a receipt</h1>
    <nav class="topbar-links">
      <a class="btn ghost" href="/inventory">Inventory</a>
    </nav>
  </header>
  <p class="tagline">Photograph a till slip and it becomes stock at home. You check the reading before anything is saved.</p>

  <% if (!enabled) { %>
    <section class="card empty">
      <h2>Not switched on</h2>
      <p class="muted">
        Reading a receipt needs an <code>ANTHROPIC_API_KEY</code>. Set one on the service and
        this page starts working — nothing else in ghrub depends on it.
      </p>
      <a class="btn" href="/inventory">Track items by hand instead</a>
    </section>
  <% } else { %>
    <section class="card scan-card">
      <label class="capture" for="receipt-photo">
        <span class="capture-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M3 8.5A2.5 2.5 0 0 1 5.5 6h1.2a2 2 0 0 0 1.7-1l.5-.8A1.5 1.5 0 0 1 10.2 3h3.6a1.5 1.5 0 0 1 1.3.7l.5.9a2 2 0 0 0 1.7 1h1.2A2.5 2.5 0 0 1 21 8.5v8A2.5 2.5 0 0 1 18.5 19h-13A2.5 2.5 0 0 1 3 16.5z"/>
            <circle cx="12" cy="12.5" r="3.5"/>
          </svg>
        </span>
        <span class="capture-title">Take a photo</span>
        <span class="capture-hint">or choose one from your gallery</span>
      </label>
      <input
        id="receipt-photo"
        class="visually-hidden"
        type="file"
        accept="<%= accepted.join(',') %>"
        capture="environment"
      />

      <figure id="receipt-preview" class="preview" hidden>
        <img alt="The receipt you selected" />
        <figcaption class="muted"></figcaption>
      </figure>

      <div class="scan-actions">
        <button id="receipt-scan" class="btn" type="button" disabled>Read it</button>
        <button id="receipt-clear" class="btn ghost" type="button" hidden>Choose another</button>
      </div>
      <p id="receipt-status" class="muted" role="status" aria-live="polite"></p>
    </section>

    <div id="receipt-result"></div>

    <script>
      // The photo is resized in the browser before it is uploaded. A modern
      // phone camera produces 4000px+ JPEGs; the model reads a receipt just as
      // well at 2048px, and the smaller image costs fewer image tokens and a
      // much shorter upload on a mobile connection.
      (() => {
        const MAX_EDGE = 2048;
        const input = document.getElementById('receipt-photo');
        const preview = document.getElementById('receipt-preview');
        const previewImg = preview.querySelector('img');
        const previewCaption = preview.querySelector('figcaption');
        const scanBtn = document.getElementById('receipt-scan');
        const clearBtn = document.getElementById('receipt-clear');
        const status = document.getElementById('receipt-status');
        const result = document.getElementById('receipt-result');
        let dataUrl = null;

        const say = (text) => { status.textContent = text; };

        const shrink = (file) =>
          new Promise((resolve, reject) => {
            const url = URL.createObjectURL(file);
            const img = new Image();
            img.onload = () => {
              URL.revokeObjectURL(url);
              const scale = Math.min(1, MAX_EDGE / Math.max(img.width, img.height));
              const canvas = document.createElement('canvas');
              canvas.width = Math.round(img.width * scale);
              canvas.height = Math.round(img.height * scale);
              canvas.getContext('2d').drawImage(img, 0, 0, canvas.width, canvas.height);
              // JPEG at 0.85 keeps small print legible without the size of a PNG.
              resolve(canvas.toDataURL('image/jpeg', 0.85));
            };
            img.onerror = () => {
              URL.revokeObjectURL(url);
              reject(new Error('That file could not be opened as an image.'));
            };
            img.src = url;
          });

        const reset = () => {
          dataUrl = null;
          input.value = '';
          preview.hidden = true;
          clearBtn.hidden = true;
          scanBtn.disabled = true;
          result.innerHTML = '';
          say('');
        };

        input.addEventListener('change', async () => {
          const file = input.files && input.files[0];
          if (!file) return;
          say('Preparing the photo…');
          try {
            dataUrl = await shrink(file);
          } catch (err) {
            say(err.message);
            return;
          }
          previewImg.src = dataUrl;
          previewCaption.textContent = file.name;
          preview.hidden = false;
          clearBtn.hidden = false;
          scanBtn.disabled = false;
          say('Ready. Check the whole slip is in frame, then read it.');
        });

        clearBtn.addEventListener('click', reset);

        scanBtn.addEventListener('click', async () => {
          if (!dataUrl) return;
          scanBtn.disabled = true;
          scanBtn.classList.add('is-busy');
          say('Reading the slip — this takes a few seconds.');
          try {
            const response = await fetch('/receipts/scan', {
              method: 'POST',
              headers: { 'content-type': 'application/json' },
              body: JSON.stringify({ image: dataUrl }),
            });
            result.innerHTML = await response.text();
            // The returned partial carries hx-post attributes of its own, so
            // HTMX has to be told to bind the markup that just arrived.
            if (window.htmx) window.htmx.process(result);
            say(response.ok ? '' : 'That did not work — see below.');
            result.scrollIntoView({ behavior: 'smooth', block: 'start' });
          } catch {
            say('The upload failed. Check your connection and try again.');
          } finally {
            scanBtn.disabled = false;
            scanBtn.classList.remove('is-busy');
          }
        });
      })();
    </script>
  <% } %>
<%- include('../partials/foot') %>
