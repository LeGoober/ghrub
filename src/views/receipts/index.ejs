<%- include('../partials/head', { title }) %>
  <header class="topbar">
    <h1>Scan a receipt</h1>
    <nav class="topbar-links">
      <a class="btn ghost" href="/inventory">Inventory</a>
    </nav>
  </header>
  <p class="tagline">Photograph a till slip and it becomes stock at home — and ticks off your list. You check the reading before anything is saved.</p>

  <section class="card scan-card" id="receipt-scanner">
    <input id="receipt-camera" class="visually-hidden" type="file" accept="<%= accepted.join(',') %>" capture="environment" />
    <input id="receipt-file" class="visually-hidden" type="file" accept="<%= accepted.join(',') %>" />
    <div class="capture-choices">
      <label class="capture" for="receipt-camera">
        <span class="capture-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M3 8.5A2.5 2.5 0 0 1 5.5 6h1.2a2 2 0 0 0 1.7-1l.5-.8A1.5 1.5 0 0 1 10.2 3h3.6a1.5 1.5 0 0 1 1.3.7l.5.9a2 2 0 0 0 1.7 1h1.2A2.5 2.5 0 0 1 21 8.5v8A2.5 2.5 0 0 1 18.5 19h-13A2.5 2.5 0 0 1 3 16.5z"/>
            <circle cx="12" cy="12.5" r="3.5"/>
          </svg>
        </span>
        <span class="capture-title">Take a photo</span>
        <span class="capture-hint">of the slip, or its QR code</span>
      </label>
      <label class="capture capture-secondary" for="receipt-file">
        <span class="capture-title">Choose from gallery</span>
      </label>
    </div>

    <figure id="receipt-preview" class="preview" hidden>
      <img alt="The receipt you selected" />
      <figcaption class="muted"></figcaption>
    </figure>

    <div class="scan-actions">
      <button id="receipt-scan" class="btn btn-lg" type="button" disabled>Read it</button>
      <button id="receipt-clear" class="btn ghost" type="button" hidden>Choose another</button>
    </div>
    <progress id="receipt-progress" class="scan-progress" max="100" value="0" hidden></progress>
    <p id="receipt-status" class="muted" role="status" aria-live="polite"></p>
    <% if (llmEnabled) { %>
      <p class="scan-alt" id="receipt-llm-wrap" hidden>
        Reading poorly? <button id="receipt-llm" class="linklike" type="button">Ask Claude instead</button>
        <span class="muted">(sends the photo to Anthropic)</span>
      </p>
    <% } %>
  </section>

  <div id="receipt-result"></div>

  <details class="card scan-tips">
    <summary>How it works, and tips</summary>
    <ul>
      <li>The slip is read <strong>on your phone</strong> with an open-source OCR engine — no AI service, no API key, and the photo is never uploaded. Only the text it read is sent to ghrub.</li>
      <li>The first scan downloads the reader (about 6&nbsp;MB) once; after that it is cached.</li>
      <li>Lay the slip flat in even light, fill the frame, and photograph a long slip in halves.</li>
      <li>Abbreviations are matched to items you already buy. Fix one in the review and ghrub remembers it.</li>
      <li>QR codes on South African slips are links to e-receipts or surveys, not the items — ghrub will say so and read the printed lines instead.</li>
    </ul>
  </details>

  <script src="/static/js/receipt-scan.js" defer></script>
<%- include('../partials/foot') %>
