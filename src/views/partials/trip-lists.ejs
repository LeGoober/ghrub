<% if (!groups.length) { %>
  <section class="card empty-card empty-compact">
    <span class="empty-icon"><%- include('icon', { name: 'basket' }) %></span>
    <p class="muted">Nothing on the list yet — add your first item above.</p>
  </section>
<% } %>

<% groups.forEach((g) => { %>
  <section class="card list-group">
    <h3 class="group-head">
      <span><%= g.label %></span>
      <span class="group-total"><%= formatCents(g.subtotal_cents) %></span>
    </h3>
    <ul class="lines">
      <% g.lines.forEach((line) => { %>
        <%- include('item-line', { trip, line, formatCents }) %>
      <% }) %>
    </ul>
  </section>
<% }) %>
