<form method="post" action="/trips">
  <label class="field">
    <span>Name</span>
    <input name="name" required placeholder="e.g. Bambezela Spezial V5" />
  </label>
  <div class="row">
    <label class="field">
      <span>Starts</span>
      <input type="date" name="start_date" />
    </label>
    <label class="field">
      <span>Lasts until</span>
      <input type="date" name="end_date" />
    </label>
    <label class="field">
      <span>Shop day</span>
      <input type="date" name="shop_date" />
    </label>
  </div>
  <div class="row">
    <label class="field">
      <span>Budget (R)</span>
      <input type="number" name="budget" min="0" step="0.01" placeholder="500" />
    </label>
    <label class="field">
      <span>Target store</span>
      <select name="target_store_id">
        <option value="">— any —</option>
        <% stores.forEach((s) => { %>
          <option value="<%= s.id %>"><%= s.name %></option>
        <% }) %>
      </select>
    </label>
  </div>
  <button class="btn" type="submit">Create trip</button>
</form>
