<section class="card compare" id="compare">
  <div class="card-head">
    <h2><%- include('icon', { name: 'store', cls: 'icon-sm icon-accent' }) %> Where to shop</h2>
  </div>

  <% if (!comparison.hasPrices) { %>
    <p class="muted small">
      No prices on file for this list yet.
      <a href="/stores/prices">Record a few</a> and ghrub will work out the cheapest store.
    </p>
  <% } else { %>

    <% if (comparison.cheapest && !comparison.cheapest.tied) { %>
      <p class="verdict<%= comparison.thinComparison ? ' is-thin' : '' %>">
        <strong><%= comparison.cheapest.storeName %></strong> is cheapest
        <% if (comparison.cheapest.savingVsNextCents) { %>
          by <strong><%= formatCents(comparison.cheapest.savingVsNextCents) %></strong>
        <% } %>
      </p>
    <% } else if (comparison.cheapest) { %>
      <p class="verdict">It is a tie on the comparable lines.</p>
    <% } %>

    <ul class="store-rows">
      <% comparison.stores.forEach((store) => { %>
        <li class="store-row<%= store.isCheapest ? ' is-cheapest' : '' %>">
          <div class="store-row-main">
            <span class="store-name">
              <%= store.storeName %>
              <% if (store.isCheapest) { %><span class="badge-cheapest">cheapest</span><% } %>
            </span>
            <span class="store-meta">
              prices <%= store.pricedCount %> of <%= store.pricedCount + store.unpricedCount %>
              <% if (store.unpricedCount) { %>
                · <span class="unpriced-flag" title="No price on file: <%= store.unpricedNames.join(', ') %>"><%= store.unpricedCount %> unpriced</span>
              <% } %>
              · all it prices <%= formatCents(store.subtotalCents) %>
            </span>
          </div>
          <span class="store-total"><%= formatCents(store.comparableCents) %></span>
        </li>
      <% }) %>
    </ul>

    <p class="muted small basis">
      Compared on the <%= comparison.comparableLineCount %> of
      <%= comparison.totalLineCount %> line<%= comparison.totalLineCount === 1 ? '' : 's' %>
      priced at every store<% if (comparison.thinComparison) { %> — too few to trust yet, add more prices<% } %>.
      Unpriced lines are flagged, never counted as free.
    </p>

    <% if (comparison.splitShop && comparison.splitShop.stops.length > 1) { %>
      <div class="split-shop">
        <h3>Cheapest per line</h3>
        <p class="muted small">
          Buying each line wherever it is cheapest comes to
          <strong><%= formatCents(comparison.splitShop.totalCents) %></strong>
          across <%= comparison.splitShop.stops.length %> stops<% if (comparison.splitShop.savingCents !== null) { %>
            —
            <% if (comparison.splitShop.worthIt) { %>
              <strong><%= formatCents(comparison.splitShop.savingCents) %></strong> less than
              <%= comparison.splitShop.bestSingleStoreName %> alone
            <% } else { %>
              no better than <%= comparison.splitShop.bestSingleStoreName %> alone, so stay in one shop
            <% } %>
          <% } %>.
        </p>
        <% if (comparison.splitShop.worthIt) { %>
          <ul class="stops">
            <% comparison.splitShop.stops.forEach((stop) => { %>
              <li>
                <div class="stop-head">
                  <strong><%= stop.storeName %></strong>
                  <span><%= formatCents(stop.subtotalCents) %></span>
                </div>
                <span class="stop-items muted small"><%= stop.items.map((i) => i.itemName).join(', ') %></span>
              </li>
            <% }) %>
          </ul>
        <% } %>
      </div>
    <% } %>

  <% } %>
</section>
