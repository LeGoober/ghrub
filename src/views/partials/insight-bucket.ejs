<div class="bucket bucket-<%= bucket.key %><%= bucket.rows.length ? '' : ' is-empty' %>" id="bucket-<%= bucket.key %>">
  <div class="bucket-head">
    <div>
      <h3 class="bucket-title"><%= bucket.title %></h3>
      <p class="muted small bucket-blurb">
        <% if (bucket.rows.length) { %>
          <%= bucket.blurb %>
        <% } else if (bucket.key === 'new') { %>
          Nothing new — every line is something you have bought before.
        <% } else if (bucket.key === 'low') { %>
          Nothing running low. <a href="/inventory">Track what you have at home</a> and ghrub will flag it here.
        <% } else { %>
          Nothing to suggest yet — shop a few trips and ghrub will spot the pattern.
        <% } %>
      </p>
    </div>
    <% if (bucket.key === 'regulars' && bucket.rows.some((r) => !r.already_on_list)) { %>
      <button
        class="btn btn-sm"
        type="button"
        hx-post="/trips/<%= trip.id %>/insights/add-regulars"
        hx-target="#trip-lists"
        hx-swap="innerHTML"
      >
        Add all
      </button>
    <% } %>
  </div>

  <% if (bucket.rows.length) { %>
    <ul class="chip-scroll">
      <% bucket.rows.forEach((row) => { %>
        <li>
          <% if (bucket.addable && !row.already_on_list) { %>
            <form
              hx-post="/trips/<%= trip.id %>/items"
              hx-target="#trip-lists"
              hx-swap="innerHTML"
            >
              <input type="hidden" name="item_name" value="<%= row.name %>" />
              <input type="hidden" name="category_key" value="<%= row.category_key %>" />
              <button class="chip chip-add" type="submit" aria-label="Add <%= row.name %> to the list">
                <span class="chip-plus" aria-hidden="true"><%- include('icon', { name: 'plus' }) %></span>
                <span class="chip-text">
                  <span class="chip-name"><%= row.name %></span>
                  <span class="chip-meta">
                    <% if (bucket.key === 'regulars') { %>
                      <%= row.trips_listed %>/<%= row.total_trips %> lists
                    <% } else if (bucket.key === 'low') { %>
                      <%= row.qty_on_hand %><%= row.unit ? ' ' + row.unit : '' %> left
                    <% } else { %>
                      on <%= row.trips_listed %> past lists
                    <% } %>
                  </span>
                </span>
              </button>
            </form>
          <% } else { %>
            <span class="chip chip-static<%= row.already_on_list ? ' is-listed' : '' %>">
              <span class="chip-text">
                <span class="chip-name"><%= row.name %></span>
                <span class="chip-meta"><%= row.already_on_list ? 'already on this list' : 'first time' %></span>
              </span>
            </span>
          <% } %>
        </li>
      <% }) %>
    </ul>
  <% } %>
</div>
