<div id="inventory-table">
  <% if (typeof error !== 'undefined' && error) { %>
    <div class="error" role="alert"><%= error %></div>
  <% } %>

  <% if (lowStock.length) { %>
    <p class="low-banner">
      <strong><%= lowStock.length %></strong>
      item<%= lowStock.length === 1 ? '' : 's' %> running low:
      <%= lowStock.map((r) => r.item_name).join(', ') %>.
      They show up as suggestions on your next trip.
    </p>
  <% } %>

  <% if (!rows.length) { %>
    <section class="card empty-card">
      <span class="empty-icon"><%- include('icon', { name: 'kitchen' }) %></span>
      <h2>Nothing tracked yet</h2>
      <p class="muted">Add what you have at home, or scan a receipt to stock up in one go.</p>
      <div class="empty-actions">
        <button class="btn" type="button" data-sheet="track-item">Track an item</button>
        <a class="btn ghost" href="/receipts">Scan a receipt</a>
      </div>
    </section>
  <% } else { %>
    <ul class="card list stock-list">
      <% rows.forEach((row) => { %>
        <% const low = row.qty_on_hand <= row.low_threshold; %>
        <li class="row stock-row<%= low ? ' is-low' : '' %>">
          <div class="row-main">
            <span class="row-title">
              <%= row.item_name %>
              <% if (low) { %><span class="badge badge-warn">low</span><% } %>
            </span>
            <span class="row-meta">restock at <%= row.low_threshold %><%= row.category_label ? ` · ${row.category_label}` : '' %></span>
          </div>
          <div class="stepper">
            <button
              class="stepper-btn"
              hx-patch="/inventory/<%= row.item_id %>"
              hx-vals='{"delta": -1}'
              hx-target="#inventory-table"
              hx-swap="outerHTML"
              aria-label="Remove one <%= row.item_name %>"
            ><%- include('icon', { name: 'minus' }) %></button>
            <span class="stepper-value"><%= row.qty_on_hand %><% if (row.unit) { %><small><%= row.unit %></small><% } %></span>
            <button
              class="stepper-btn"
              hx-patch="/inventory/<%= row.item_id %>"
              hx-vals='{"delta": 1}'
              hx-target="#inventory-table"
              hx-swap="outerHTML"
              aria-label="Add one <%= row.item_name %>"
            ><%- include('icon', { name: 'plus' }) %></button>
          </div>
        </li>
      <% }) %>
    </ul>
  <% } %>
</div>
