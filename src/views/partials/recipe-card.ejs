<article class="card recipe" id="recipe-<%= recipe.id %>">
  <div class="recipe-head">
    <h3><%= recipe.name %></h3>
    <form
      hx-post="/meals/log"
      hx-target="#meal-log"
      hx-swap="outerHTML"
    >
      <input type="hidden" name="recipe_id" value="<%= recipe.id %>" />
      <button class="btn btn-sm" type="submit" title="Log this as eaten and draw down its ingredients">
        Ate this
      </button>
    </form>
  </div>

  <% if (recipe.ingredients.length) { %>
    <div class="chip-row">
      <% recipe.ingredients.forEach((i) => { %><span class="chip"><%= i.item_name %></span><% }) %>
    </div>
  <% } else { %>
    <p class="muted small">No ingredients yet — eating it will not move any stock.</p>
  <% } %>

  <details <%= typeof open !== 'undefined' && open && !recipe.ingredients.length ? 'open' : '' %>>
    <summary>Edit ingredients <%- include('icon', { name: 'down', cls: 'icon-sm disclosure' }) %></summary>
    <form
      class="ingredient-editor form-stack"
      hx-post="/recipes/<%= recipe.id %>/ingredients"
      hx-target="#recipe-<%= recipe.id %>"
      hx-swap="outerHTML"
    >
      <label class="field">
        <span>One per line — anything new is added to the catalog</span>
        <textarea name="ingredient" rows="4" placeholder="Pasta&#10;Chicken breasts&#10;Onions"><%= recipe.ingredients.map((i) => i.item_name).join('\n') %></textarea>
      </label>
      <button class="btn" type="submit">Save ingredients</button>
    </form>
  </details>
</article>
