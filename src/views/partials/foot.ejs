    </main>

    <%
      /* The primary navigation on a phone. `currentPath` is set on res.locals in
         server.js; the guard keeps this partial renderable without it.

         The icons and the aria-current attribute below are emitted with the
         UNESCAPED output tag. The escaping one would turn the quotes in
         aria-current="page" into entities and print the SVG markup as visible
         text. (Never write a closing EJS tag inside a comment like this one —
         EJS scans for it literally and would end the scriptlet right here.) */
      const here = typeof currentPath === 'string' ? currentPath : '';
      const TABS = [
        {
          href: '/',
          label: 'Home',
          active: here === '/',
          icon: '<path d="M3 10.5 12 3l9 7.5"/><path d="M5.5 9.5V20h13V9.5"/>',
        },
        {
          href: '/trips',
          label: 'Trips',
          active: here.startsWith('/trips'),
          icon: '<path d="M4.5 7h15l-1.2 12.2a1.8 1.8 0 0 1-1.8 1.6H7.5a1.8 1.8 0 0 1-1.8-1.6z"/><path d="M9 7V5.6A2.6 2.6 0 0 1 11.6 3h.8A2.6 2.6 0 0 1 15 5.6V7"/>',
        },
        {
          href: '/receipts',
          label: 'Scan',
          active: here.startsWith('/receipts'),
          icon: '<path d="M3 8.5A2.5 2.5 0 0 1 5.5 6h1.2a2 2 0 0 0 1.7-1l.5-.8A1.5 1.5 0 0 1 10.2 3h3.6a1.5 1.5 0 0 1 1.3.7l.5.9a2 2 0 0 0 1.7 1h1.2A2.5 2.5 0 0 1 21 8.5v8A2.5 2.5 0 0 1 18.5 19h-13A2.5 2.5 0 0 1 3 16.5z"/><circle cx="12" cy="12.5" r="3.5"/>',
        },
        {
          href: '/inventory',
          label: 'Kitchen',
          active: here.startsWith('/inventory') || here.startsWith('/recipes'),
          icon: '<path d="M5 3h14v18H5z"/><path d="M5 9h14M5 15h14"/>',
        },
        {
          href: '/history',
          label: 'Spend',
          active: here.startsWith('/history'),
          icon: '<path d="M4 20V4"/><path d="M4 20h16"/><path d="M8 20v-6M13 20V9M18 20v-9"/>',
        },
      ];
    %>
    <nav class="tabbar" aria-label="Sections">
      <% TABS.forEach((tab) => { %>
        <a
          class="tab<%= tab.active ? ' is-current' : '' %>"
          href="<%= tab.href %>"
          <%- tab.active ? 'aria-current="page"' : '' %>
        >
          <svg viewBox="0 0 24 24" aria-hidden="true"><%- tab.icon %></svg>
          <span class="tab-label"><%= tab.label %></span>
        </a>
      <% }) %>
    </nav>

    <div id="toast" class="toast" aria-live="assertive"></div>

    <script>
      // Errors land in #toast (see the htmx-config meta in head.ejs). Show them
      // for a few seconds, and say so plainly when the request never arrived.
      (() => {
        const toast = document.getElementById('toast');
        let timer;
        const show = () => {
          toast.classList.add('is-shown');
          clearTimeout(timer);
          timer = setTimeout(() => {
            toast.classList.remove('is-shown');
            toast.innerHTML = '';
          }, 6000);
        };
        document.body.addEventListener('htmx:afterSwap', (event) => {
          if (event.detail.target === toast) show();
        });
        document.body.addEventListener('htmx:sendError', () => {
          toast.innerHTML = '';
          const box = document.createElement('div');
          box.className = 'error';
          box.setAttribute('role', 'alert');
          box.textContent = navigator.onLine
            ? 'Could not reach ghrub. Nothing was saved — try again.'
            : 'You are offline. Nothing was saved — reconnect and try again.';
          toast.appendChild(box);
          show();
        });
        toast.addEventListener('click', () => toast.classList.remove('is-shown'));
      })();

      // Bottom sheets: any [data-sheet="x"] opens <dialog id="sheet-x">; any
      // [data-close] inside closes it, as does a tap on the backdrop. A form
      // inside a sheet closes it once its request succeeds.
      (() => {
        const open = (id) => {
          const sheet = document.getElementById(`sheet-${id}`);
          if (sheet && !sheet.open) sheet.showModal();
        };
        document.addEventListener('click', (event) => {
          const opener = event.target.closest('[data-sheet]');
          if (opener) {
            event.preventDefault();
            open(opener.dataset.sheet);
            return;
          }
          const closer = event.target.closest('[data-close]');
          if (closer) {
            closer.closest('dialog')?.close();
            return;
          }
          if (event.target.matches('dialog.sheet')) event.target.close();
        });
        document.body.addEventListener('htmx:afterRequest', (event) => {
          const sheet = event.detail.elt.closest?.('dialog.sheet');
          if (sheet && event.detail.successful) sheet.close();
        });
      })();

      // Rows that expand (a list line's editor, a meal-plan day) stay expanded
      // when HTMX re-renders the list under them — otherwise every edit would
      // snap the editor shut mid-task.
      (() => {
        const openKeys = new Set();
        const sync = (el) => {
          const key = el.dataset.keepOpen;
          const isOpen = el.tagName === 'DETAILS' ? el.open : el.classList.contains('is-open');
          if (isOpen) openKeys.add(key);
          else openKeys.delete(key);
        };
        document.addEventListener('click', (event) => {
          const toggle = event.target.closest('[data-toggle-open]');
          if (!toggle) return;
          const row = toggle.closest('[data-keep-open]');
          if (!row) return;
          row.classList.toggle('is-open');
          toggle.setAttribute('aria-expanded', String(row.classList.contains('is-open')));
          sync(row);
        });
        document.addEventListener(
          'toggle',
          (event) => {
            if (event.target.matches?.('details[data-keep-open]')) sync(event.target);
          },
          true
        );
        document.body.addEventListener('htmx:afterSettle', () => {
          for (const key of openKeys) {
            const el = document.querySelector(`[data-keep-open="${CSS.escape(key)}"]`);
            if (!el) continue;
            if (el.tagName === 'DETAILS') el.open = true;
            else {
              el.classList.add('is-open');
              el.querySelector('[data-toggle-open]')?.setAttribute('aria-expanded', 'true');
            }
          }
        });
      })();

      // Installability (M5). Registration is best-effort: the service worker
      // only caches the static shell, so a failure here costs nothing.
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/sw.js').catch(() => {});
        });
      }
    </script>
  </body>
</html>
