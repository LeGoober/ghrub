<div id="price-rows">
  <% if (typeof error !== 'undefined' && error) { %>
    <div class="error" role="alert"><%= error %></div>
  <% } %>

  <% if (!prices.length) { %>
    <p class="muted small">Nothing recorded yet — add your first price above.</p>
  <% } else { %>
    <ul class="card list">
      <% prices.forEach((row) => { %>
        <li class="row">
          <div class="row-main">
            <span class="row-title"><%= row.item_name %></span>
            <span class="row-meta"><%= row.store_name %> · <span class="seen-date"><%= row.seen_date %></span></span>
          </div>
          <span class="row-value"><%= formatCents(row.price_cents) %></span>
        </li>
      <% }) %>
    </ul>
  <% } %>
</div>
