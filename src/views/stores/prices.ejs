<%- include('../partials/head', { title }) %>
  <header class="app-bar">
    <a class="icon-btn" href="/history" aria-label="Back to spend"><%- include('../partials/icon', { name: 'back' }) %></a>
    <div class="app-bar-title">
      <h1>Prices</h1>
      <p class="app-bar-sub">What things cost, per shop. The most recent price wins.</p>
    </div>
  </header>

  <section class="card">
    <div class="card-head"><h2>Record a price</h2></div>
    <form
      id="price-form"
      hx-post="/stores/prices"
      hx-target="#price-rows"
      hx-swap="outerHTML"
      hx-on::after-request="if (event.detail.successful) { this.querySelector('[name=price]').value = ''; }"
    >
      <div class="form-stack">
        <label class="field">
          <span>Item</span>
          <input
            id="price-item"
            name="item_name"
            autocomplete="off"
            required
            value="<%= focusItem ? focusItem.name : '' %>"
            placeholder="Type to search catalog…"
            hx-get="/stores/prices/suggest"
            hx-trigger="keyup changed delay:250ms"
            hx-target="#price-suggest"
            hx-swap="innerHTML"
          />
        </label>
        <div id="price-suggest"></div>
        <div class="field-row">
        <label class="field">
          <span>Store</span>
          <select name="store_id" required>
            <% stores.forEach((s) => { %>
              <option value="<%= s.id %>"><%= s.name %></option>
            <% }) %>
          </select>
        </label>
        <label class="field">
          <span>Price (R)</span>
          <input name="price" type="number" inputmode="decimal" min="0" step="0.01" required placeholder="25.99" />
        </label>
        </div>
        <label class="field">
          <span>Seen on</span>
          <input name="seen_date" type="date" value="<%= new Date().toLocaleDateString('en-CA', { timeZone: 'Africa/Johannesburg' }) %>" />
        </label>
        <button class="btn btn-lg" type="submit">Save price</button>
      </div>
    </form>

    <% if (focusItem && knownForFocus.length) { %>
      <p class="muted small known-prices">
        Last seen for <strong><%= focusItem.name %></strong>:
        <% knownForFocus.forEach((p, i) => { %><%= i ? ' · ' : '' %><%= p.store_name %>
          <%= formatCents(p.price_cents) %> <span class="seen-date">(<%= p.seen_date %>)</span><% }) %>
      </p>
    <% } %>
  </section>

  <h2 class="section-title">Recorded prices</h2>
  <%- include('../partials/price-rows', { prices, formatCents, error: null }) %>

  <script>
    // Same type-ahead behaviour as the trip workspace: pick a name, clear the list.
    document.getElementById('price-suggest').addEventListener('click', (event) => {
      const btn = event.target.closest('[data-pick-name]');
      if (!btn) return;
      document.getElementById('price-item').value = btn.dataset.pickName;
      document.getElementById('price-suggest').innerHTML = '';
    });
  </script>
<%- include('../partials/foot') %>
