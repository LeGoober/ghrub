<%- include('../partials/head', { title }) %>
  <header class="app-bar app-bar-large">
    <div class="app-bar-title">
      <h1>Trips</h1>
    </div>
    <button class="btn btn-sm" type="button" data-sheet="new-trip">
      <%- include('../partials/icon', { name: 'plus', cls: 'icon-sm' }) %> New trip
    </button>
  </header>

  <% if (error) { %>
    <div class="error" role="alert"><%= error %></div>
  <% } %>

  <% if (trips.length) { %>
    <ul class="trip-list">
      <% trips.forEach((t) => { %>
        <% const b = t.budget; %>
        <li>
          <a class="card trip-card" href="/trips/<%= t.id %>">
            <div class="trip-card-top">
              <span class="trip-card-name"><%= t.name %></span>
              <span class="pill pill-<%= t.status %>"><%= t.status %></span>
            </div>
            <p class="trip-card-meta">
              <%= t.shop_date || t.start_date || 'No date' %> · <%= t.item_count %> item<%= t.item_count === 1 ? '' : 's' %>
              <% if (b && b.budgetCents != null) { %>
                · <span class="budget-word budget-<%= b.state %>"><%= b.state === 'over' ? 'over budget' : b.state === 'near' ? 'near budget' : 'on track' %></span>
              <% } %>
            </p>
            <% if (b && b.budgetCents != null) { %>
              <div class="progress progress-thin budget-<%= b.state %>"><span style="width: <%= Math.min((b.pct || 0) * 100, 100) %>%"></span></div>
              <p class="trip-card-figures"><%= formatCents(b.subtotalCents) %> <span class="muted">of <%= formatCents(b.budgetCents) %></span></p>
            <% } %>
          </a>
        </li>
      <% }) %>
    </ul>
  <% } else { %>
    <section class="card empty-card">
      <span class="empty-icon"><%- include('../partials/icon', { name: 'basket' }) %></span>
      <h2>No trips yet</h2>
      <p class="muted">Create one and start adding what you need.</p>
      <button class="btn btn-lg" type="button" data-sheet="new-trip">New trip</button>
    </section>
  <% } %>

  <%- include('../partials/new-trip-sheet', { stores }) %>
<%- include('../partials/foot') %>
