<%- include('../partials/head', { title }) %>
  <%- include('../partials/trip-header', { trip, stores }) %>

  <%- include('../partials/budget-bar', { budget, formatCents, oob: false }) %>

  <section class="card add-item">
    <form
      id="add-item"
      hx-post="/trips/<%= trip.id %>/items"
      hx-target="#trip-lists"
      hx-swap="innerHTML"
      hx-on::after-request="if (event.detail.successful) { this.reset(); this.querySelector('#item-name').focus(); }"
    >
      <div class="add-bar">
        <label class="add-input">
          <span class="visually-hidden">Item</span>
          <input
            id="item-name"
            name="item_name"
            autocomplete="off"
            autocapitalize="sentences"
            enterkeyhint="done"
            placeholder="Add an item…"
            required
            hx-get="/trips/<%= trip.id %>/items/suggest"
            hx-trigger="input changed delay:200ms"
            hx-target="#suggest"
            hx-swap="innerHTML"
          />
        </label>
        <button class="btn add-btn" type="submit" aria-label="Add to list"><%- include('../partials/icon', { name: 'plus' }) %></button>
      </div>
      <div id="suggest"></div>
      <details class="add-more">
        <summary>Category and estimate</summary>
        <div class="field-row">
          <label class="field">
            <span>Category</span>
            <select name="category_key">
              <option value="">Auto</option>
              <% categories.forEach((c) => { %>
                <option value="<%= c.key %>"><%= c.label %></option>
              <% }) %>
            </select>
          </label>
          <label class="field">
            <span>Estimate (R)</span>
            <input name="est" type="number" min="0" step="0.01" inputmode="decimal" placeholder="25" />
          </label>
        </div>
      </details>
    </form>
  </section>

  <% if (llm) { %>
    <%# Only rendered when ENABLE_LLM=true — the app is complete without it. %>
    <div id="explain-panel">
      <button
        class="btn ghost explain-trigger"
        hx-get="/trips/<%= trip.id %>/explain"
        hx-target="#explain-panel"
        hx-swap="outerHTML"
        hx-indicator="#explain-spinner"
      >
        Explain this shop
        <span id="explain-spinner" class="spinner" aria-hidden="true"></span>
      </button>
    </div>
  <% } %>

  <div id="trip-lists">
    <%- include('../partials/trip-lists', { trip, groups, formatCents }) %>
  </div>

  <%- include('../partials/insight-buckets', { trip, buckets, cadence, oob: false }) %>

  <!-- Loaded on demand and refreshed when the list changes. Mutations send an
       HX-Trigger header rather than carrying the whole comparison in every
       partial — the basket only needs re-pricing when its lines move. -->
  <div
    hx-get="/trips/<%= trip.id %>/compare"
    hx-trigger="load, ghrub:list-changed from:body"
    hx-swap="innerHTML"
  ></div>

  <!-- The meal-plan is heavier than the rest of the page and only matters once
       the trip has dates, so it loads on demand too (M4). -->
  <div hx-get="/trips/<%= trip.id %>/plan" hx-trigger="load" hx-swap="innerHTML"></div>

  <script>
    // Pick a type-ahead suggestion: fill the item input, clear the dropdown.
    document.getElementById('suggest').addEventListener('click', (event) => {
      const btn = event.target.closest('[data-pick-name]');
      if (!btn) return;
      const input = document.getElementById('item-name');
      if (input) input.value = btn.dataset.pickName;
      document.getElementById('suggest').innerHTML = '';
      input.form.requestSubmit();
    });
  </script>
<%- include('../partials/foot') %>
