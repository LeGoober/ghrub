<%- include('../partials/head', { title }) %>
  <nav class="crumbs">
    <a href="/trips">All trips</a> · <a href="/history">History</a> · <a href="/">Home</a>
  </nav>

  <%- include('../partials/trip-header', { trip, stores }) %>

  <%- include('../partials/budget-bar', { budget, formatCents, oob: false }) %>

  <section class="card add-item">
    <h2>Add item</h2>
    <form
      id="add-item"
      hx-post="/trips/<%= trip.id %>/items"
      hx-target="#trip-lists"
      hx-swap="innerHTML"
      hx-on::after-request="if (event.detail.successful) this.reset()"
    >
      <div class="row">
        <label class="field grow">
          <span>Item</span>
          <input
            id="item-name"
            name="item_name"
            autocomplete="off"
            placeholder="Type to search catalog…"
            hx-get="/trips/<%= trip.id %>/items/suggest"
            hx-trigger="keyup changed delay:250ms"
            hx-target="#suggest"
            hx-swap="innerHTML"
          />
        </label>
        <label class="field">
          <span>Category</span>
          <select name="category_key">
            <% categories.forEach((c) => { %>
              <option value="<%= c.key %>"><%= c.label %></option>
            <% }) %>
          </select>
        </label>
        <label class="field">
          <span>Est. (R)</span>
          <input name="est" type="number" min="0" step="0.01" placeholder="25" />
        </label>
        <button class="btn" type="submit">Add</button>
      </div>
      <div id="suggest"></div>
    </form>
  </section>

  <%- include('../partials/insight-buckets', { trip, buckets, cadence, oob: false }) %>

  <div id="trip-lists">
    <%- include('../partials/trip-lists', { trip, groups, formatCents }) %>
  </div>

  <script>
    // Pick a type-ahead suggestion: fill the item input, clear the dropdown.
    document.getElementById('suggest').addEventListener('click', (event) => {
      const btn = event.target.closest('[data-pick-name]');
      if (!btn) return;
      const input = document.getElementById('item-name');
      if (input) input.value = btn.dataset.pickName;
      document.getElementById('suggest').innerHTML = '';
    });
  </script>
<%- include('../partials/foot') %>
