<%- include('partials/head', { title }) %>
  <header class="topbar">
    <h1>ghrub</h1>
    <nav class="topbar-links">
      <a class="btn ghost" href="/recipes">Recipes</a>
      <a class="btn ghost" href="/inventory">Inventory</a>
      <a class="btn ghost" href="/stores/prices">Prices</a>
      <a class="btn ghost" href="/history">History</a>
      <a class="btn ghost" href="/trips">All trips</a>
    </nav>
  </header>
  <p class="tagline">Your groceries, remembered.</p>

  <% if (active) { %>
    <section class="card">
      <h2>Next shop</h2>
      <a class="big-link" href="/trips/<%= active.id %>"><%= active.name %></a>
      <p class="muted">
        <%= active.shop_date || active.start_date || 'no date set' %>
        · <%= active.item_count %> items
      </p>
    </section>
  <% } else { %>
    <section class="card">
      <p class="muted">No trips yet — create your first one below.</p>
    </section>
  <% } %>

  <a class="card scan-cta" href="/receipts">
    <span class="scan-cta-title">Scan a receipt</span>
    <span class="muted">Restock the kitchen and tick off your list from a till slip.</span>
  </a>

  <% if (lowStock && lowStock.length) { %>
    <section class="card">
      <h2>Running low</h2>
      <div class="chip-row">
        <% lowStock.slice(0, 12).forEach((row) => { %>
          <span class="chip chip-low"><%= row.item_name %> · <%= row.qty_on_hand %> left</span>
        <% }) %>
      </div>
      <p class="muted">
        <%= lowStock.length > 12 ? `and ${lowStock.length - 12} more. ` : '' %>Open your next trip to add them in one tap.
      </p>
    </section>
  <% } %>

  <section class="card">
    <h2>New trip</h2>
    <%- include('partials/trip-form', { stores }) %>
  </section>
<%- include('partials/foot') %>
