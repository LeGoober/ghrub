<%- include('../partials/head', { title }) %>
  <header class="app-bar app-bar-large">
    <div class="app-bar-title">
      <h1>Kitchen</h1>
      <p class="app-bar-sub">What you cook, and what it uses. Logging a meal draws its ingredients down.</p>
    </div>
    <button class="btn btn-sm" type="button" data-sheet="add-recipe">
      <%- include('../partials/icon', { name: 'plus', cls: 'icon-sm' }) %> Recipe
    </button>
  </header>

  <%- include('../partials/kitchen-nav', { current: 'recipes' }) %>

  <section class="card">
    <div class="card-head"><h2>Log a meal</h2></div>
    <p class="muted small">Pick a recipe to draw its ingredients down, or just note what you ate.</p>
    <form
      class="form-stack"
      hx-post="/meals/log"
      hx-target="#meal-log"
      hx-swap="outerHTML"
      hx-on::after-request="if (event.detail.successful) this.reset()"
    >
      <div class="field-row">
        <label class="field">
          <span>Recipe</span>
          <select name="recipe_id">
            <option value="">Something else</option>
            <% recipes.forEach((r) => { %>
              <option value="<%= r.id %>"><%= r.name %></option>
            <% }) %>
          </select>
        </label>
        <label class="field">
          <span>Or describe it</span>
          <input name="free_text" placeholder="Leftovers" autocomplete="off" />
        </label>
      </div>
      <div class="field-row field-row-end">
        <label class="field">
          <span>When</span>
          <input name="eaten_date" type="date" value="<%= new Date().toLocaleDateString('en-CA', { timeZone: 'Africa/Johannesburg' }) %>" />
        </label>
        <button class="btn" type="submit">Log it</button>
      </div>
    </form>
  </section>

  <div id="meal-log">
    <h3 class="section-title">Recently eaten</h3>
    <% if (recentMeals.length) { %>
      <ul class="card list meal-history">
        <% recentMeals.forEach((meal) => { %>
          <li class="row">
            <span class="row-title"><%= meal.recipe_name || meal.free_text %></span>
            <span class="meal-date"><%= meal.eaten_date %></span>
          </li>
        <% }) %>
      </ul>
    <% } else { %>
      <p class="muted small">Nothing logged yet.</p>
    <% } %>
  </div>

  <h2 class="section-title">Recipes</h2>
  <div id="recipe-list" class="recipe-list">
    <% recipes.forEach((recipe) => { %>
      <%- include('../partials/recipe-card', { recipe, open: false }) %>
    <% }) %>
  </div>
  <% if (!recipes.length) { %>
    <p class="muted small">No recipes yet — add the meals you cook most.</p>
  <% } %>

  <dialog class="sheet" id="sheet-add-recipe" aria-labelledby="add-recipe-title">
    <div class="sheet-panel">
      <header class="sheet-head">
        <h2 id="add-recipe-title">Add a recipe</h2>
        <button class="icon-btn" type="button" data-close aria-label="Close"><%- include('../partials/icon', { name: 'close' }) %></button>
      </header>
      <form
        class="form-stack"
        hx-post="/recipes"
        hx-target="#recipe-list"
        hx-swap="afterbegin"
        hx-on::after-request="if (event.detail.successful) this.reset()"
      >
        <label class="field">
          <span>Name</span>
          <input name="name" required placeholder="e.g. Chicken Alfredo" autocomplete="off" />
        </label>
        <p class="muted small">You can add its ingredients on the recipe card.</p>
        <button class="btn btn-lg" type="submit">Add recipe</button>
      </form>
    </div>
  </dialog>
<%- include('../partials/foot') %>
